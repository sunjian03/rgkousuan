{
  "meta": {
    "version": "1.0",
    "date": "2026-11-02",
    "schema": {
      "id": "知识点全局唯一标识（kebab-case），练习记录与错题快照引用它",
      "name": "知识点名称（与原型出题设置页 UI 完全一致）",
      "semester": "学期：一上/一下/二上/二下/三上/三下",
      "op": "运算类型：+、-、×、÷ 或组合 +-；mixed=混合运算、unit=单位换算、frac=分数、clock=钟表",
      "basicRules": "基础档出题参数（R3 难度梯度），范围一律用 [min,max] 闭区间",
      "advanceRules": "进阶档出题参数，结构同 basicRules"
    },
    "constraints": {
      "sub-nonneg": "减法结果非负（被减数 ≥ 减数）",
      "sub-borrow": "减法必须退位",
      "carry-or-borrow": "加法必须进位 / 减法必须退位",
      "no-carry": "加法不进位 / 减法不退位（逐位）",
      "multiple-of-10": "操作数均为 10 的整数倍",
      "div-exact": "除法整除（余数为 0）",
      "div-remainder": "有余数除法，余数 ∈ [1, 除数-1]",
      "div-exact-step": "混合运算中 ÷ 步骤必须整除",
      "sub-nonneg-step": "混合运算中间结果非负",
      "same-denominator": "同分母分数",
      "proper-result": "结果必须为真分数（分子 < 分母）",
      "paren": "表达式含括号"
    }
  },
  "semesters": ["一上", "一下", "二上", "二下", "三上", "三下"],
  "knowledgePoints": [
    {
      "id": "g1a-add-sub-10",
      "name": "10 以内加减法",
      "semester": "一上",
      "op": "+-",
      "basicRules": { "a": [1, 9], "b": [1, 9], "result": [0, 10], "constraints": ["sub-nonneg"] },
      "advanceRules": { "a": [3, 9], "b": [3, 9], "result": [6, 10], "constraints": ["sub-nonneg"] }
    },
    {
      "id": "g1a-add-carry-20",
